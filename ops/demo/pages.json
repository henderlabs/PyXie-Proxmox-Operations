[
 {
  "name": "dashboard",
  "path": "/"
 },
 {
  "name": "dashboard-balance",
  "path": "/",
  "clip": "(()=>{const f=(t)=>[...document.querySelectorAll('h2,h3,div,span,p')].find(e=>e.children.length===0&&e.textContent.trim().toUpperCase().startsWith(t));const card=(e)=>{let n=e;while(n&&!(getComputedStyle(n).borderTopWidth!=='0px'&&n.getBoundingClientRect().width>400))n=n.parentElement;return n;};const a=card(f('CLUSTER RESOURCE USAGE')).getBoundingClientRect(),b=card(f('HOST LOAD')).getBoundingClientRect();const x=Math.min(a.x,b.x)-12,y=a.y-12;return {x,y,width:Math.max(a.right,b.right)-x+12,height:b.bottom-y+12};})()"
 },
 {
  "name": "rightsizing",
  "path": "/operations/recommendations"
 },
 {
  "name": "maintenance",
  "path": "/operations/maintenance"
 },
 {
  "name": "affinity-rules",
  "path": "/operations/affinity-rules"
 },
 {
  "name": "workloads",
  "path": "/infrastructure/workloads"
 },
 {
  "name": "cluster-left",
  "path": "/infrastructure/nodes",
  "run": "(()=>{const a=[...document.querySelectorAll('a')].find(x=>x.textContent.trim()==='example-cluster');a&&a.click();return new Promise(r=>setTimeout(r,2500)).then(()=>{const h=[...document.querySelectorAll('div,h2,h3')].find(x=>x.children.length===0&&/^left the cluster$/i.test(x.textContent.trim()));h&&h.scrollIntoView({block:'center'});});})()",
  "runWait": 6000
 },
 {
  "name": "host-left-the-cluster",
  "path": "/infrastructure/nodes/{node:node-e}",
  "wait": 7000
 },
 {
  "name": "host-config",
  "path": "/infrastructure/nodes/{node:node-a}?tab=config",
  "run": "(()=>{const h=[...document.querySelectorAll('*')].find(x=>x.children.length===0&&/^Node options$/i.test(x.textContent.trim()));h&&h.scrollIntoView({block:'start'});window.scrollBy(0,-90);return new Promise(r=>setTimeout(r,1500));})()",
  "runWait": 2500,
  "wait": 7000
 },
 {
  "name": "balance-load",
  "path": "/operations/balance",
  "run": "[...document.querySelectorAll('button')].find(b=>b.textContent.trim()==='Select heavy nodes').click();new Promise(r=>setTimeout(r,1500)).then(()=>[...document.querySelectorAll('button')].find(b=>b.textContent.includes('Preview Balance Load')).click())",
  "runWait": 9000
 },
 {
  "name": "tasks-panel",
  "path": "/infrastructure/workloads",
  "clip": "(()=>{const w=window.innerWidth;return {x:w-320,y:0,width:320,height:Math.min(window.innerHeight,900)};})()"
 }
]